/**
 * Invoice Management - Client-side actions with offline-first architecture
 * Part of the offline-first architecture implementation (Phase 5 - Financial System)
 */

'use client';

import { db } from '@/lib/offline/dexie-db';
import { Invoice, InvoiceInsert, InvoiceUpdate } from '@/types/invoices';
import { getCurrentUserId, isOnline } from './auth-utils';

// Helper to get current user and business context
async function getCurrentUserContext(): Promise<{ userId: string | null; businessId: string | null }> {
    // Get user ID from auth utils
    const userId = await getCurrentUserId();
    
    // Get business ID from localStorage
    const businessId = typeof window !== 'undefined' ? 
        localStorage.getItem('businessId') : null;
        
    return { userId, businessId };
}

/**
 * Get all invoices for the current business
 */
export async function getInvoices(): Promise<Invoice[] | { error: string }> {
    try {
        const { userId, businessId } = await getCurrentUserContext();
        
        if (!userId) {
            return { error: 'User not authenticated' };
        }
        
        if (!businessId) {
            return { error: 'Business ID not available' };
        }

        // Get invoices from local database
        const invoices = await db.invoices
            .where('business_id')
            .equals(businessId)
            .toArray();
            
        return invoices;
    } catch (error) {
        console.error('Error getting invoices:', error);
        return { error: 'Failed to get invoices' };
    }
}
